# Copy to .env (never commit that file) and fill in. See README.md.
# Cloudflare account ID (the same one as in GitHub)
CF_ACCOUNT_ID=
# ID of the key-value store "trapvrij-lifts"
CF_KV_NAMESPACE_ID=
# The key that may only edit the key-value store ("trapvrij-lifts-writer")
CF_API_TOKEN=
# For a first test without publishing: writes /data/lifts.json instead
# DRY_RUN=1
